{
  "name": "BNY",
  "scopeName": "source.bny",
  "patterns": [
    {
      "include": "#comment"
    },
    {
      "include": "#option"
    },
    {
      "include": "#set"
    },
    {
      "include": "#signal"
    },
    {
      "include": "#speaker"
    },
    {
      "include": "#speaker-shorthand"
    },
    {
      "include": "#skip-tag"
    },
    {
      "include": "#branch-tag"
    },
    {
      "include": "#condition"
    },
    {
      "include": "#label"
    },
    {
      "include": "#goto"
    },
    {
      "include": "#escape"
    },
    {
      "include": "#variable"
    },
    {
      "include": "#brace"
    }
  ],
  "repository": {
    "comment": {
      "name": "comment.line.number-sign.bny",
      "match": "#.*$"
    },
    "escape": {
      "name": "constant.character.escape.bny",
      "match": "&(lbrack|rbrack|lbrace|rbrace|hash|pipe|amp);"
    },
    "variable": {
      "name": "variable.other.bny",
      "match": "\\$[A-Za-z_][A-Za-z0-9_]*"
    },
    "label": {
      "name": "meta.label.bny",
      "match": "^[ \\t]*(@)[ \\t]*([^#{}\\[\\]|\\n]+)",
      "captures": {
        "1": {
          "name": "keyword.control.label.bny"
        },
        "2": {
          "name": "entity.name.label.bny",
          "patterns": [
            {
              "include": "#escape"
            }
          ]
        }
      }
    },
    "goto": {
      "name": "meta.goto.bny",
      "match": "^[ \\t]*(->)[ \\t]*([^#{}\\[\\]|\\n]+)",
      "captures": {
        "1": {
          "name": "keyword.control.goto.bny"
        },
        "2": {
          "name": "entity.name.label.bny",
          "patterns": [
            {
              "include": "#escape"
            }
          ]
        }
      }
    },
    "skip-tag": {
      "patterns": [
        {
          "name": "meta.block.skip.begin.bny",
          "match": "(\\[)(skip)(:)([^\\]#\\n]+)(\\])",
          "captures": {
            "1": {
              "name": "punctuation.definition.tag.begin.bny"
            },
            "2": {
              "name": "keyword.control.skip.bny"
            },
            "3": {
              "name": "punctuation.separator.key-value.bny"
            },
            "4": {
              "name": "entity.name.label.bny",
              "patterns": [
                {
                  "include": "#escape"
                }
              ]
            },
            "5": {
              "name": "punctuation.definition.tag.end.bny"
            }
          }
        },
        {
          "name": "meta.block.skip.end.bny",
          "match": "(\\[/)(skip)(\\])",
          "captures": {
            "1": {
              "name": "punctuation.definition.tag.begin.bny"
            },
            "2": {
              "name": "keyword.control.skip.bny"
            },
            "3": {
              "name": "punctuation.definition.tag.end.bny"
            }
          }
        }
      ]
    },
    "branch-tag": {
      "name": "meta.branch.bny",
      "match": "(\\[/?)(branch)(\\])",
      "captures": {
        "1": {
          "name": "punctuation.definition.tag.begin.bny"
        },
        "2": {
          "name": "keyword.control.branch.bny"
        },
        "3": {
          "name": "punctuation.definition.tag.end.bny"
        }
      }
    },
    "condition": {
      "name": "meta.condition.bny",
      "match": "(\\[)(when)(:)[ \\t]*([A-Za-z_][A-Za-z0-9_]*)[ \\t]*(=)([^\\]#\\n]+)(\\])",
      "captures": {
        "1": {
          "name": "punctuation.definition.tag.begin.bny"
        },
        "2": {
          "name": "keyword.control.branch-case.bny"
        },
        "3": {
          "name": "punctuation.separator.key-value.bny"
        },
        "4": {
          "name": "variable.other.bny"
        },
        "5": {
          "name": "keyword.operator.assignment.bny"
        },
        "6": {
          "name": "constant.other.branch-value.bny",
          "patterns": [
            {
              "include": "#escape"
            }
          ]
        },
        "7": {
          "name": "punctuation.definition.tag.end.bny"
        }
      }
    },
    "option-id": {
      "name": "meta.option.id.bny",
      "match": "(\\[)(id)(:)([^\\]#\\n]+)(\\])",
      "captures": {
        "1": {
          "name": "punctuation.definition.tag.begin.bny"
        },
        "2": {
          "name": "keyword.other.option-id.bny"
        },
        "3": {
          "name": "punctuation.separator.key-value.bny"
        },
        "4": {
          "name": "entity.name.option.bny",
          "patterns": [
            {
              "include": "#escape"
            }
          ]
        },
        "5": {
          "name": "punctuation.definition.tag.end.bny"
        }
      }
    },
    "option": {
      "name": "meta.option.bny",
      "begin": "^[ \\t]*(\\?:)",
      "beginCaptures": {
        "1": {
          "name": "keyword.control.option.bny"
        }
      },
      "end": "(?=[#{}])|$",
      "contentName": "string.unquoted.option-text.bny",
      "patterns": [
        {
          "include": "#condition"
        },
        {
          "include": "#option-id"
        },
        {
          "include": "#escape"
        }
      ]
    },
    "set": {
      "name": "meta.directive.set.bny",
      "match": "^[ \\t]*(:SET)\\b[ \\t]+([A-Za-z_][A-Za-z0-9_]*)(?:[ \\t]*(=)([^#\\n]*))?",
      "captures": {
        "1": {
          "name": "keyword.other.directive.bny"
        },
        "2": {
          "name": "variable.other.bny"
        },
        "3": {
          "name": "keyword.operator.assignment.bny"
        },
        "4": {
          "name": "string.unquoted.set-value.bny",
          "patterns": [
            {
              "include": "#escape"
            },
            {
              "include": "#variable"
            }
          ]
        }
      }
    },
    "signal": {
      "name": "meta.directive.signal.bny",
      "match": "^[ \\t]*(:SIGNAL|:YIELD)\\b[ \\t]+([A-Za-z_][A-Za-z0-9_]*)(?:[ \\t]*(:)([^#\\n]*))?",
      "captures": {
        "1": {
          "name": "keyword.control.directive.bny"
        },
        "2": {
          "name": "entity.name.function.signal.bny"
        },
        "3": {
          "name": "punctuation.separator.key-value.bny"
        },
        "4": {
          "name": "string.unquoted.directive-value.bny",
          "patterns": [
            {
              "include": "#escape"
            }
          ]
        }
      }
    },
    "speaker": {
      "name": "meta.directive.speaker.bny",
      "match": "^[ \\t]*(:SPEAKER|:ALTERNATE)\\b([^#\\n]*)",
      "captures": {
        "1": {
          "name": "keyword.other.directive.bny"
        },
        "2": {
          "name": "string.unquoted.speaker.bny",
          "patterns": [
            {
              "include": "#escape"
            }
          ]
        }
      }
    },
    "speaker-shorthand": {
      "name": "meta.speaker.bny",
      "match": "^[ \\t]*(\\|)([^|#\\n]*)(\\|)",
      "captures": {
        "1": {
          "name": "punctuation.definition.speaker.begin.bny"
        },
        "2": {
          "name": "entity.name.speaker.bny",
          "patterns": [
            {
              "include": "#escape"
            }
          ]
        },
        "3": {
          "name": "punctuation.definition.speaker.end.bny"
        }
      }
    },
    "brace": {
      "patterns": [
        {
          "name": "punctuation.section.block.begin.bny",
          "match": "\\{"
        },
        {
          "name": "punctuation.section.block.end.bny",
          "match": "\\}"
        }
      ]
    }
  }
}
