{
  "Branch Block": {
    "prefix": "branch",
    "description": "Insert a BNY branch block",
    "body": [
      "[branch]",
      "    [when:${1:identifier}=${2:value}]",
      "        $0",
      "[/branch]"
    ]
  },
  "Skip Block": {
    "prefix": "skip",
    "description": "Insert a BNY skip block",
    "body": [
      "[skip:${1:label}]",
      "    $0",
      "[/skip]"
    ]
  }
}
