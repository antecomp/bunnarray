{
  "name": "bunnarray",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "vite apps/playground --config apps/playground/vite.config.ts",
    "build": "tsc && vite build apps/playground --config apps/playground/vite.config.ts",
    "preview": "vite preview apps/playground --config apps/playground/vite.config.ts",
    "test": "vitest run",
    "lint": "eslint \"**/*.ts\"",
    "lint:fix": "eslint \"**/*.ts\" --fix"
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^26.6.6",
    "@typescript-eslint/parser": "^8.67.0",
    "eslint": "^10.13.0",
    "typescript": "~5.6.2",
    "vite": "^6.0.3",
    "vitest": "^4.1.12",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.3.2"
  }
}
