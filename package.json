{
  "name": "bunnarry",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": ["packages/*", "apps/*"],
  "scripts": {
    "dev": "vite apps/playground --config apps/playground/vite.config.ts",
    "build": "tsc && vite build apps/playground --config apps/playground/vite.config.ts",
    "preview": "vite preview apps/playground --config apps/playground/vite.config.ts",
    "test": "vitest run",
    "lint": "eslint \"**/*.{ts,tsx}\"",
    "lint:staged": "bun scripts/lint-staged.mjs",
    "lint:fix": "eslint \"**/*.{ts,tsx}\" --fix"
  },
  "devDependencies": {
    "typescript": "~5.6.2",
    "vite": "^6.0.3",
    "vitest": "^4.1.12",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@typescript-eslint/parser": "^8.67.0",
    "eslint": "^10.13.0"
  }
}
